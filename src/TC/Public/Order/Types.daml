-- Serializable order data and pure validation without Tradecraft core types.

module TC.Public.Order.Types
  ( module TC.Public.Order.Types
  ) where

import DA.Map (Map)

import Splice.Api.Token.AllocationInstructionV2 (AllocationFactory)
import Splice.Api.Token.AllocationV2 (Allocation, SettlementFactory)
import Splice.Api.Token.HoldingV1 (Holding, InstrumentId(..))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.HoldingV2 (Account)
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Splice.Api.Token.TransferInstructionV1 (TransferInstruction)
import Splice.Api.Token.TransferInstructionV1 qualified as TransferInstructionV1

data PoolRef = PoolRef
  with
    venue : Party
    vault : Party
    ammId : Text
    instrument1 : InstrumentId
    instrument2 : InstrumentId
  deriving (Eq, Ord, Show)
data TickRange = TickRange
  with
    lower : Int
    upper : Int
  deriving (Eq, Ord, Show)
isValidRange : TickRange -> Bool
isValidRange r =
  r.lower < r.upper && -230270 <= r.lower && r.upper <= 230270
data SwapDirection
  = SwapExactInput
    with
      inputInstrument : InstrumentId
      inputAmount : Decimal
  | SwapExactOutput
    with
      outputInstrument : InstrumentId
      outputAmount : Decimal
  deriving (Eq, Ord, Show)
data Operation
  = OpSwap
    with
      direction : SwapDirection
      sqrtPriceLimit : Numeric 20
  | OpDeposit
    with
      range : TickRange
      requestedLiquidity : Decimal
  | OpWithdraw
    with
      range : TickRange
      liquidity : Decimal
      -- ^ Zero selects the fee-refresh operation.
  | OpCollect
    with
      range : TickRange
      cap1 : Optional Decimal
      cap2 : Optional Decimal
      -- ^ Optional per-instrument caps on the collected amounts.
  deriving (Eq, Ord, Show)
data Funding
  = FundingStanding
    -- ^ Use the actor's standing settlement allocations.
  | FundingAllocations
    with
      allocationCids : [ContractId Allocation]
      -- ^ Embedded committed V2 allocations.
  | FundingHoldings
    with
      holdingCids : [ContractId Holding]
  | FundingTransfersToActor
    with
      instructionCids : [ContractId TransferInstruction]
    -- ^ Pending transfer offers addressed to the order actor.
    --   Acceptance uses the actor's receiving authority.
  | FundingTransfersToVault
    with
      instructionCids : [ContractId TransferInstruction]
    -- ^ Pending transfer offers from the order actor to the pool vault.
    --   Preparation accepts them under the vault's receiving authority,
    --   funds a vault-owned allocation by exactly the planned debit,
    --   and returns any surplus to the actor as ordinary holdings.
  deriving (Eq, Ord, Show)
data Input = Input
  with
    maxDebits : Map InstrumentId Decimal
    funding : Funding
  deriving (Eq, Ord, Show)
data Output = Output
  with
    minOutputs : Map InstrumentId Decimal
  deriving (Eq, Ord, Show)
data OrderSpec = OrderSpec
  with
    operation : Operation
    input : Input
    output : Output
    expiresAt : Optional Time
  deriving (Eq, Ord, Show)
data Outcome
  = OutcomeCancelled
  | OutcomeRejected Text
    -- ^ Diagnostic text, not a machine-readable protocol branch.
  | OutcomePendingSettlement
  | OutcomeSettled
  deriving (Eq, Ord, Show)
data PositionSnapshot = PositionSnapshot
  with
    owner : Party
    ammId : Text
    range : TickRange
    liquidity : Decimal
    feeGrowthInside1Last : Numeric 20
    feeGrowthInside2Last : Numeric 20
    tokensOwed1 : Numeric 20
    tokensOwed2 : Numeric 20
  deriving (Eq, Ord, Show)
data InstrumentContext = InstrumentContext
  with
    instrument : InstrumentId
    account : Account
    -- ^ Actor account for ordinary funding, outputs, or a direct-funding
    --   refund; vault account for direct transfer funding.
    targetAllocationCid : Optional (ContractId Allocation)
    -- ^ Selected standing allocation; None lets preparation create one.
    allocationFactoryCid : ContractId AllocationFactory
    allocationExtraArgs : ExtraArgs
    settlementFactoryCid : ContractId SettlementFactory
    settlementExtraArgs : ExtraArgs
    transferAcceptExtraArgs : Map (ContractId TransferInstruction) ExtraArgs
    -- ^ Accept arguments per pending transfer instruction.
  deriving (Eq, Show)
data PlannedDebit = PlannedDebit
  with
    instrument : InstrumentId
    amount : Decimal
    source : DebitSource
  deriving (Eq, Ord, Show)
data DebitSource
  = DebitStanding
    with
      allocationCid : ContractId Allocation
    -- ^ The actor's standing allocation named in the context.
  | DebitAllocations
    with
      allocationCids : [ContractId Allocation]
    -- ^ Embedded committed allocations owned by the actor.
  | DebitHoldings
    with
      holdingCids : [ContractId Holding]
  | DebitTransferToActor
    with
      instructionCids : [ContractId TransferInstruction]
    -- ^ Pending transfer offers addressed to the order actor. Acceptance
    --   credits the actor, and the actor's context funds the debit.
  | DebitTransferToVault
    with
      instructionCids : [ContractId TransferInstruction]
    -- ^ Pending transfer offers from the order actor to the pool vault.
    --   The vault's context funds the debit directly; a surplus returns
    --   to the actor as ordinary holdings.
  deriving (Eq, Ord, Show)
data FundingSource
  = FundingSourceHolding (ContractId HoldingV1.Holding)
  | FundingSourceTransfer (ContractId TransferInstructionV1.TransferInstruction)
  deriving (Eq, Ord, Show)
data FundingSourceView = FundingSourceView
  with
    instrument : InstrumentId
    amount : Decimal
  deriving (Eq, Show)
maxAmountBound : Decimal
maxAmountBound = 1.0e17
validAmount : Decimal -> Bool
validAmount a = a > 0.0 && a <= maxAmountBound
