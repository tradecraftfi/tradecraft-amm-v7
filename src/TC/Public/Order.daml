-- Partners create, cancel, and read orders without the Tradecraft core.
-- This package uses Token Standard interfaces and does not calculate prices.

module TC.Public.Order
  ( module TC.Public.Order
  , module TC.Public.Order.Allocation
  , module TC.Public.Order.Types
  ) where

import DA.Foldable (forA_)
import DA.List qualified as List
import DA.Map (Map)
import DA.Map qualified as Map
import DA.Optional (fromOptional, isNone, isSome)
import DA.Set qualified as Set
import DA.TextMap qualified as TextMap

import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Splice.Api.Token.HoldingV1 qualified as HoldingV1
import Splice.Api.Token.HoldingV2 (Holding)
import Splice.Api.Token.TransferInstructionV1 qualified as TransferInstructionV1

import TC.Public.Order.Allocation (CheckAllocArgs(..), CreateSettlementAllocationArgs(..), FundSettlementAllocationArgs(..), acceptTransferInstruction, assertE, checkAllocation, createSettlementAllocation, fundSettlementAllocation, fundVaultDebit, prepareDebit, require, requireE, tcSettlementId, requireSome, validateContext)
import TC.Public.Order.Types

template Order
  with
    actor : Party
    venue : Party
    vault : Party
    pool : PoolRef
    tickSpacing : Int
    operation : Operation
    input : Input
    output : Output
    createdAt : Time
    expiresAt : Optional Time
  where
    signatory actor, vault
    observer venue

    ensure
      pool.venue == venue
      && pool.vault == vault
      && case validateOrderStatic pool tickSpacing (OrderSpec with
        operation
        input
        output
        expiresAt) of
          Right () -> True
          Left _ -> False

    -- | Cancellation consumes no funds. Standing allocations stay live.
    nonconsuming choice Order_PrepareFunding : Order_PrepareFunding_Result
      with
        plannedDebits : [PlannedDebit]
        plannedOutputs : Map InstrumentId Decimal
        contexts : [InstrumentContext]
      controller venue, vault
      do
        now <- getTime
        require "Order must not be expired" $ notExpired expiresAt now
        orderRecord <- fetch self
        require "Planned debits must name distinct instruments" $
          List.unique (map (.instrument) plannedDebits)
        forA_ plannedDebits \debit -> validateDebit orderRecord debit
        validateOutputs orderRecord plannedOutputs
        require "Context accounts must have an owner" $
          all (\ctx -> isSome ctx.account.owner) contexts
        let allowsVaultContext = case orderRecord.input.funding of
              FundingTransfersToVault _ -> True
              _ -> False
        require "Contexts must belong to the order actor or the vault" $
          all (\ctx -> case ctx.account.owner of
            Some owner -> owner == orderRecord.actor
              || (allowsVaultContext && owner == orderRecord.vault)
            None -> False) contexts
        let ctxByPair = Map.fromList
              [ ((owner, ctx.instrument), ctx)
              | ctx <- contexts
              , Some owner <- [ctx.account.owner]
              ]
            actorPair instrument = (orderRecord.actor, instrument)
            debitOwner source = case source of
              DebitTransferToVault _ -> orderRecord.vault
              _ -> orderRecord.actor
            requiredPairs =
              [ (debitOwner debit.source, debit.instrument)
              | debit <- plannedDebits
              ]
              <> [ actorPair instrument
                 | (instrument, amount) <- Map.toList plannedOutputs
                 , amount > 0.0
                 ]
        require "Contexts must name distinct owners and instruments" $
          Map.size ctxByPair == length contexts
        require "Each debit and positive output needs its owner's context" $
          all (`Map.member` ctxByPair) requiredPairs
        prepared <- forA (Map.toList ctxByPair) \((owner, instrument), ctx) -> do
          let debits = [debit | debit <- plannedDebits,
                               debit.instrument == instrument,
                               debitOwner debit.source == owner]
          outcome <- case debits of
            [] -> do
              validateContext venue owner orderRecord.pool.ammId
                (poolInstrumentsOf orderRecord.pool) ctx
              pure ([], [])
            [debit] -> case debit.source of
              DebitTransferToVault offers -> do
                funded <- fundVaultDebit
                  venue actor vault orderRecord.pool.ammId
                  (poolInstrumentsOf orderRecord.pool)
                  ctx (Map.lookup (actorPair instrument) ctxByPair)
                  debit.amount offers
                pure ([funded.allocationCid], funded.changeHoldingCids)
              _ -> prepareInstrument orderRecord ctx instrument debits
            _ -> fail "One instrument must have one planned debit"
          pure ((owner, instrument), outcome)
        let preparedByPair = Map.fromList prepared
        -- Positive outputs always receive through an actor-owned
        -- context; vault funding never supplies a receiver here.
        receiving <- forA
          [pair | pair@((owner, _), _) <- Map.toList ctxByPair, owner == orderRecord.actor]
          \((_, instrument), ctx) ->
            if fromOptional 0.0 (Map.lookup instrument plannedOutputs) > 0.0
              then do
                let inputAllocations = fst $ fromOptional ([], []) $
                      Map.lookup (orderRecord.actor, instrument) preparedByPair
                allocationCid <- case inputAllocations of
                  [allocationCid] -> pure allocationCid
                  [] -> case ctx.targetAllocationCid of
                    Some allocationCid -> pure allocationCid
                    None -> createEmptyReceiving venue actor orderRecord ctx
                  _ -> fail "One instrument must select one allocation"
                pure (instrument, Some allocationCid)
              else pure (instrument, None)
        pure Order_PrepareFunding_Result with
          inputAllocations = Map.fromList
            [ (instrument, allocations)
            | ((_, instrument), (allocations, _)) <- prepared
            , not (null allocations)
            ]
          receivingAllocations = Map.fromList
            [ (instrument, allocationCid)
            | (instrument, Some allocationCid) <- receiving
            ]
          changeHoldingCids = concat
            [ changeCids
            | (_, (_, changeCids)) <- prepared
            ]

    -- | Read one signed funding source. The venue and vault controllers
    -- supply the read, and the order's actor and vault signatories
    -- authorize fetching the one named source; no other source read or
    -- token action is authorized. The kind and signed-membership checks
    -- run before any source fetch, so an unsigned or wrong-kind CID is
    -- never fetched. Semantic invalidity of a signed source is a Left; a
    -- stale or inaccessible CID remains a transaction error. The choice
    -- performs no token action, no preparation, and no completion.
    nonconsuming choice Order_ReadFundingSource : Either Text FundingSourceView
      with
        source : FundingSource
      controller venue, vault
      do
        case (input.funding, source) of
          (FundingHoldings cids, FundingSourceHolding cid)
            | not (cid `elem` cids) ->
              pure (Left "Funding source holding is not signed by this order")
            | otherwise -> readHoldingSource this cid
          (FundingTransfersToActor cids, FundingSourceTransfer cid)
            | not (cid `elem` cids) ->
              pure (Left "Funding source offer is not signed by this order")
            | otherwise -> readIncomingOfferSource this cid
          (FundingTransfersToVault cids, FundingSourceTransfer cid)
            | not (cid `elem` cids) ->
              pure (Left "Funding source offer is not signed by this order")
            | otherwise -> readVaultOfferSource this cid
          _ -> pure (Left "Funding source kind must match the order's funding kind")

    -- | Complete the order with its actual amounts and position snapshot.
    -- Successful partial fills must still satisfy the actor's signed limits.
    choice Order_Complete : ContractId Result
      with
        outcome : Outcome
        actualInputs : Map InstrumentId Decimal
        actualOutputs : Map InstrumentId Decimal
        positionSnapshot : Optional PositionSnapshot
      controller venue, vault
      do
        require "A completed order must not be cancelled" $
          outcome /= OutcomeCancelled
        case outcome of
          OutcomeRejected _ ->
            require "Rejected orders must not record payment legs" $
              all (== 0.0) (Map.values actualInputs)
                && all (== 0.0) (Map.values actualOutputs)
          _ -> do
            require "Actual inputs must name pool instruments" $
              all (`elem` poolInstrumentsOf pool) (Map.keys actualInputs)
            require "Actual inputs must be nonnegative and within the signed maxima" $
              all (\(instrument, amount) ->
                amount >= 0.0
                  && amount <= fromOptional 0.0 (Map.lookup instrument input.maxDebits))
                (Map.toList actualInputs)
            validateOutputs this actualOutputs
        now <- getTime
        createResult self this now outcome actualInputs actualOutputs positionSnapshot
data Order_PrepareFunding_Result = Order_PrepareFunding_Result
  with
    inputAllocations : Map InstrumentId [ContractId AllocationV2.Allocation]
    -- ^ Selected allocations per instrument, after funding. Settlement
    -- must use these final IDs; funding may have archived a predecessor.
    receivingAllocations : Map InstrumentId (ContractId AllocationV2.Allocation)
    -- ^ Selected allocations for this order's positive output legs.
    changeHoldingCids : [ContractId Holding]
    -- ^ Every holding the token standard returned to the actor,
    --   including the refund of overfunded direct vault funding.
  deriving (Eq, Show)
template Result
  with
    orderCid : ContractId Order
    actor : Party
    pool : PoolRef
    operation : Operation
    outcome : Outcome
    actualInputs : Map InstrumentId Decimal
    actualOutputs : Map InstrumentId Decimal
    positionSnapshot : Optional PositionSnapshot
    executedAt : Time
  where
    signatory pool.vault
    observer actor, pool.venue

    ensure
      nonnegativeMap actualInputs
      && nonnegativeMap actualOutputs

    -- | Follow a deferred settlement. Only a pending result can become
    -- settled. The choice runs inside the actual settlement transaction,
    -- so the transition reflects real ledger settlement.
    choice Result_MarkSettled : ContractId Result
      -- Stored payment legs and the position snapshot cannot change.
      controller pool.venue, pool.vault
      do
        require "Only a pending result can be marked settled" $
          outcome == OutcomePendingSettlement
        now <- getTime
        create this with
          outcome = OutcomeSettled
          executedAt = now
validateOrderStatic : PoolRef -> Int -> OrderSpec -> Either Text ()
validateOrderStatic pool tickSpacing spec = do
  requireE "Tick spacing must be positive" $ tickSpacing > 0
  requireE "Pool instruments must be distinct" $
    pool.instrument1 /= pool.instrument2
  requireE "Input instruments must be pool instruments" $
    all (`elem` poolInstrumentsOf pool) (Map.keys spec.input.maxDebits)
  requireE "Input maxima must be positive and within the amount bound" $
    all validAmount (Map.values spec.input.maxDebits)
  requireE "Explicit funding must name distinct, nonempty sources" $
    validFunding spec.input.funding
  requireE "Output instruments must be pool instruments" $
    all (`elem` poolInstrumentsOf pool) (Map.keys spec.output.minOutputs)
  requireE "Output minima must be nonnegative and within the amount bound" $
    all (\a -> a >= 0.0 && a <= maxAmountBound) (Map.values spec.output.minOutputs)
  case spec.operation of
    OpSwap dir limit -> do
      requireE "Price limit must be positive" $ limit > 0.0
      case dir of
        SwapExactInput instrument amount -> do
          requireE "Swap input instrument must be a pool instrument" $
            instrument `elem` poolInstrumentsOf pool
          requireE "Swap input amount must be positive and within the amount bound" $
            validAmount amount
        SwapExactOutput instrument amount -> do
          requireE "Swap output instrument must be a pool instrument" $
            instrument `elem` poolInstrumentsOf pool
          requireE "Swap output amount must be positive and within the amount bound" $
            validAmount amount
    OpDeposit range requestedLiquidity -> do
      requireE "Deposit range must be valid and tick aligned" $
        isValidRange range && aligned tickSpacing range
      requireE "Deposit liquidity must be positive and within the amount bound" $
        validAmount requestedLiquidity
      requireE "Deposit output minimums must be empty" $
        Map.null spec.output.minOutputs
    OpWithdraw range liquidity -> do
      requireE "Withdrawal range must be valid and tick aligned" $
        isValidRange range && aligned tickSpacing range
      requireE "Withdrawal liquidity must be nonnegative and within the amount bound" $
        liquidity >= 0.0 && liquidity <= maxAmountBound
      requireE "Withdrawal input must be empty" $ Map.null spec.input.maxDebits
      requireE "Withdrawal funding must be standing" $
        spec.input.funding == FundingStanding
    OpCollect range cap1 cap2 -> do
      requireE "Collection range must be valid and tick aligned" $
        isValidRange range && aligned tickSpacing range
      requireE "Collection caps must be nonnegative and within the amount bound" $
        all (\c -> c >= 0.0 && c <= maxAmountBound) (maybeToList cap1 <> maybeToList cap2)
      requireE "Collection input must be empty" $ Map.null spec.input.maxDebits
      requireE "Collection funding must be standing" $
        spec.input.funding == FundingStanding
poolInstrumentsOf : PoolRef -> [InstrumentId]
poolInstrumentsOf p = [p.instrument1, p.instrument2]
validFunding : Funding -> Bool
validFunding = \case
  FundingStanding -> True
  FundingAllocations cids -> not (null cids) && List.unique cids
  FundingHoldings cids -> not (null cids) && List.unique cids
  FundingTransfersToActor cids -> not (null cids) && List.unique cids
  FundingTransfersToVault cids -> not (null cids) && List.unique cids
readHoldingSource : Order -> ContractId HoldingV1.Holding -> Update (Either Text FundingSourceView)
readHoldingSource order cid = do
  holding <- view <$> fetch @HoldingV1.Holding cid
  pure $ do
    requireE "Holding owner must be the order actor" $ holding.owner == order.actor
    requireE "Holding instrument must be a pool instrument" $
      holding.instrumentId `elem` poolInstrumentsOf order.pool
    requireE "Holding amount must be positive" $ holding.amount > 0.0
    requireE "Holding must be unlocked" $ isNone holding.lock
    Right FundingSourceView with
      instrument = holding.instrumentId
      amount = holding.amount
readIncomingOfferSource
  : Order -> ContractId TransferInstructionV1.TransferInstruction -> Update (Either Text FundingSourceView)
readIncomingOfferSource order cid = do
  instruction <- view <$> fetch @TransferInstructionV1.TransferInstruction cid
  pure $ do
    requireE "Transfer receiver must be the order actor" $
      instruction.transfer.receiver == order.actor
    requireE "Transfer instrument must be a pool instrument" $
      instruction.transfer.instrumentId `elem` poolInstrumentsOf order.pool
    requireE "Transfer amount must be positive" $ instruction.transfer.amount > 0.0
    requireE "Transfer must await receiver acceptance" $
      instruction.status == TransferInstructionV1.TransferPendingReceiverAcceptance
    Right FundingSourceView with
      instrument = instruction.transfer.instrumentId
      amount = instruction.transfer.amount
readVaultOfferSource
  : Order -> ContractId TransferInstructionV1.TransferInstruction -> Update (Either Text FundingSourceView)
readVaultOfferSource order cid = do
  instruction <- view <$> fetch @TransferInstructionV1.TransferInstruction cid
  pure $ do
    requireE "Transfer sender must be the order actor" $
      instruction.transfer.sender == order.actor
    requireE "Transfer receiver must be the pool vault" $
      instruction.transfer.receiver == order.vault
    requireE "Transfer instrument must be a pool instrument" $
      instruction.transfer.instrumentId `elem` poolInstrumentsOf order.pool
    requireE "Transfer amount must be positive" $ instruction.transfer.amount > 0.0
    requireE "Transfer must await receiver acceptance" $
      instruction.status == TransferInstructionV1.TransferPendingReceiverAcceptance
    Right FundingSourceView with
      instrument = instruction.transfer.instrumentId
      amount = instruction.transfer.amount
aligned : Int -> TickRange -> Bool
aligned spacing r =
  spacing > 0 && (r.lower % spacing) == 0 && (r.upper % spacing) == 0
nonnegativeMap : Map InstrumentId Decimal -> Bool
nonnegativeMap = all (>= 0.0) . Map.values
notExpired : Optional Time -> Time -> Bool
notExpired expiry now = case expiry of
  None -> True
  Some expiry -> now <= expiry
createResult
  : ContractId Order
  -> Order
  -> Time
  -> Outcome
  -> Map InstrumentId Decimal
  -> Map InstrumentId Decimal
  -> Optional PositionSnapshot
  -> Update (ContractId Result)
createResult orderCid order now outcome actualInputs actualOutputs positionSnapshot = do
  create Result with
    orderCid
    actor = order.actor
    pool = order.pool
    operation = order.operation
    outcome
    actualInputs
    actualOutputs
    positionSnapshot
    executedAt = now
prepareInstrument
  : Order
  -> InstrumentContext
  -> InstrumentId
  -> [PlannedDebit]
  -> Update ([ContractId AllocationV2.Allocation], [ContractId Holding])
prepareInstrument order ctx instrument debits = do
  validateContext order.venue order.actor order.pool.ammId (poolInstrumentsOf order.pool) ctx
  case debits of
    -- No actor debit for this instrument: the context only supplies a
    -- receiving allocation or a direct-funding refund receiver.
    [] -> pure ([], [])
    _ -> do
      require "One instrument must have exactly one planned debit" $
        length debits == 1
      let debit = case debits of
            (d :: _) -> d
            [] -> error "unreachable"
      require "Debit instrument must match the context" $
        debit.instrument == instrument
      case debit.source of
        DebitStanding allocationCid -> do
          selected <- requireSome "Standing debit requires a selected target allocation" ctx.targetAllocationCid
          require "Standing debit must use the context's selected allocation" $
            selected == allocationCid
          requireAllocationFunding order ctx debit.amount allocationCid
          pure ([allocationCid], [])
        DebitAllocations allocationCids -> case allocationCids of
          [allocationCid] -> do
            requireAllocationFunding order ctx debit.amount allocationCid
            pure ([allocationCid], [])
          _ -> fail "One instrument must select one embedded allocation"
        DebitHoldings holdingCids -> do
          forA_ holdingCids \holdingCid -> do
            holding <- view <$> fetch @HoldingV1.Holding holdingCid
            require "Holding owner must be the order actor" $
              holding.owner == order.actor
            require "Holding instrument must match the planned debit" $
              holding.instrumentId == instrument
          outcome <- prepareDebit order.venue order.actor order.pool.ammId
            (poolInstrumentsOf order.pool) ctx debit.amount (map coerceContractId holdingCids)
          pure ([outcome.allocationCid], outcome.changeHoldingCids)
        DebitTransferToActor instructionCids -> do
          holdingCids <- concat <$> forA instructionCids (acceptTransferInstruction order.actor ctx)
          outcome <- prepareDebit order.venue order.actor order.pool.ammId (poolInstrumentsOf order.pool) ctx debit.amount holdingCids
          pure ([outcome.allocationCid], outcome.changeHoldingCids)
        DebitTransferToVault _ ->
          fail "TC.Public.Order.prepareInstrument: vault debit requires a vault context"
requireAllocationFunding
  : Order -> InstrumentContext -> Decimal -> ContractId AllocationV2.Allocation -> Update ()
requireAllocationFunding order ctx amount allocationCid = do
  checked <- assertE =<< checkAllocation (embeddedCheckArgs order ctx) allocationCid
  require "Selected allocation must use the context account" $
    checked.authorizer == ctx.account
  require "Selected allocation must cover the planned debit" $
    fromOptional 0.0 (TextMap.lookup ctx.instrument.id checked.nextIterationFunding) >= amount
embeddedCheckArgs : Order -> InstrumentContext -> CheckAllocArgs
embeddedCheckArgs order ctx = CheckAllocArgs with
  venue = order.venue
  settlementId = tcSettlementId
  ammId = order.pool.ammId
  authorizerOwner = order.actor
  instrumentOpt = Some ctx.instrument
  poolInstruments = poolInstrumentsOf order.pool
validateDebit : Order -> PlannedDebit -> Update ()
validateDebit order debit = do
  require "Planned debit must be positive" $ debit.amount > 0.0
  maximumDebit <- requireSome "Planned debit has no input maximum" $
    Map.lookup debit.instrument order.input.maxDebits
  require "Planned debit must not exceed the input maximum" $
    debit.amount <= maximumDebit
  let sourceMatches = case (order.input.funding, debit.source) of
        (FundingStanding, DebitStanding _) -> True
        (FundingAllocations signed, DebitAllocations supplied) -> signedSources signed supplied
        (FundingHoldings signed, DebitHoldings supplied) -> signedSources signed supplied
        (FundingTransfersToActor signed, DebitTransferToActor supplied) ->
          signedSources signed supplied
        (FundingTransfersToVault signed, DebitTransferToVault supplied) ->
          signedSources signed supplied
        _ -> False
  require "Debit sources must come from the order's signed funding" sourceMatches
signedSources : Ord a => [a] -> [a] -> Bool
signedSources signed supplied =
  let authorized = Set.fromList signed
  in not (null supplied) && List.unique supplied
    && all (`Set.member` authorized) supplied
validateOutputs : Order -> Map InstrumentId Decimal -> Update ()
validateOutputs order outputs = do
  require "Outputs must name pool instruments" $
    all (`elem` poolInstrumentsOf order.pool) (Map.keys outputs)
  require "Outputs must be nonnegative and within the amount bound" $
    all (\amount -> amount >= 0.0 && amount <= maxAmountBound) (Map.values outputs)
  require "Outputs must satisfy the order's minimums" $
    all (\(instrument, minimum) -> fromOptional 0.0 (Map.lookup instrument outputs) >= minimum)
      (Map.toList order.output.minOutputs)
  let allowed = case order.operation of
        OpSwap (SwapExactInput instrument _) _ ->
          [i | i <- poolInstrumentsOf order.pool, i /= instrument]
        OpSwap (SwapExactOutput instrument _) _ -> [instrument]
        OpDeposit _ _ -> []
        OpWithdraw _ liquidity ->
          if liquidity > 0.0 then poolInstrumentsOf order.pool else []
        OpCollect _ _ _ -> poolInstrumentsOf order.pool
  require "Output instrument must match the operation" $
    all (\(instrument, amount) -> amount == 0.0 || instrument `elem` allowed) (Map.toList outputs)
  case order.operation of
    OpCollect _ cap1 cap2 -> do
      forA_ [(order.pool.instrument1, cap1), (order.pool.instrument2, cap2)] \(instrument, cap) ->
        case cap of
          None -> pure ()
          Some maximum -> require "Collection must not exceed its cap" $
            fromOptional 0.0 (Map.lookup instrument outputs) <= maximum
    _ -> pure ()
maybeToList : Optional a -> [a]
maybeToList = \case
  Some a -> [a]
  None -> []
createEmptyReceiving : Party -> Party -> Order -> InstrumentContext -> Update (ContractId AllocationV2.Allocation)
createEmptyReceiving venue actor order ctx = do
  validateContext venue actor order.pool.ammId (poolInstrumentsOf order.pool) ctx
  (allocationCid, _changeCids) <- createSettlementAllocation $
    CreateSettlementAllocationArgs with
      ammId = order.pool.ammId
      instruments = poolInstrumentsOf order.pool
      venue
      allocationActor = actor
      instrument = ctx.instrument
      authorizerAccount = ctx.account
      initialFunding = None
      inputHoldingCids = []
      allocationFactoryCid = ctx.allocationFactoryCid
      extraArgs = ctx.allocationExtraArgs
  pure allocationCid
